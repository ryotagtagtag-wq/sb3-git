{
  "name": "sb3-git",
  "version": "0.1.0",
  "description": "Git-based collaborative development toolchain for Scratch .sb3 projects",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli/index.js",
      "types": "./dist/cli/index.d.ts"
    }
  },
  "bin": {
    "sb3-git": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "scratch",
    "sb3",
    "git",
    "collaboration",
    "version-control",
    "diff",
    "merge"
  ],
  "author": "Ryo Tagtag <game-ryo>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/game-ryo/sb3-git.git"
  },
  "bugs": {
    "url": "https://github.com/game-ryo/sb3-git/issues"
  },
  "homepage": "https://github.com/game-ryo/sb3-git#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/diff": "^5.2.1",
    "@types/node": "^20.10.0",
    "prettier": "^3.1.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  },
  "dependencies": {
    "@turbowarp/jszip": "^3.10.1",
    "@types/jsdom": "^30.0.0",
    "commander": "^11.1.0",
    "diff": "^5.1.0",
    "fast-levenshtein": "^3.0.0",
    "jsdom": "^30.0.1",
    "parse-sb3-blocks": "^0.5.2",
    "scratchblocks": "^3.7.1",
    "zod": "^3.22.4"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  }
}
